# ==============================================================================
# Deriva Environment Configuration
# ==============================================================================
# .env lives in the Deriva home folder: ~/.deriva/.env for an installed tool
# (DERIVA_HOME moves the folder), the repository root in a source checkout.
# Copy this file there as .env and fill in your values; the studio's General page
# writes the model settings for you. A variable set in the environment wins over
# the file. .env is gitignored for security.

# ==============================================================================
# GRAFEO CONFIGURATION (Embedded Graph Database)
# ==============================================================================
# Directory with one <repository>.grafeo database per repository (combined runs use the
# joined repository names; commands without --repo use default.grafeo), relative to the
# home folder. Default workspace/graphs; empty = in-memory (nothing is kept after a command).
GRAFEO_DB_DIR=workspace/graphs
GRAFEO_LOG_QUERIES=false
# Language of every graph query: gql (ISO GQL, the default) or cypher
GRAFEO_QUERY_LANGUAGE=gql

# NLP for business concepts: the folder for its translation models (downloaded on first use)
DERIVA_NLP_MODELS_DIR=workspace/cache/nlp

# Graph namespace (label prefix for extraction data)
GRAPH_NAMESPACE=Graph

# ArchiMate namespace (label prefix for model data)
ARCHIMATE_NAMESPACE=Model

# Validation settings
ARCHIMATE_VALIDATION_STRICT_MODE=false

# ==============================================================================
# LLM CONFIGURATION
# ==============================================================================
# Default model: the name of a model config below (lowercase with hyphens). The default is a
# local Ollama model, so a first run costs nothing; switch to a cloud model once its key is set
LLM_DEFAULT_MODEL=ollama-devstral

# Temperature for LLM queries (0.0-2.0, lower = more deterministic). 0 gives the most
# repeatable answers; a step's own temperature and a model's LLM_{NAME}_TEMPERATURE override it
LLM_TEMPERATURE=0.0

# LLM cache settings
LLM_CACHE_DIR=workspace/cache/llm
LLM_CACHE_TTL=0

# Graph cache settings
GRAPH_CACHE_DIR=workspace/cache/graph

LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
LLM_MAX_TOKENS=

# Disable caching (true/false) - when true, skips reading cache but still writes
LLM_NOCACHE=false

# ==============================================================================
# PYDANTIC AI STANDARD API KEYS
# ==============================================================================
# The standard variables PydanticAI reads for each provider; a model config's own _KEY wins.
# Uncomment the ones you use (a placeholder value would be sent to the provider as a key)

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=

# Rate limiting settings
# 0 = use provider-specific default (azure/openai/anthropic/mistral: 60 RPM, ollama/lmstudio: unlimited)
LLM_RATE_LIMIT_RPM=0
# Minimum delay between requests in seconds (0.0 = no minimum delay)
LLM_RATE_LIMIT_DELAY=0.0
# Max retries on rate limit (429) errors before failing
LLM_RATE_LIMIT_RETRIES=3

# Per-model rate limits (override global/provider defaults)
# Format: LLM_{MODEL_NAME}_RPM=requests_per_minute
# Model names match benchmark model names (uppercase, underscores)
# LLM_MISTRAL_SMALL_RPM=24
# LLM_OPENAI_LUNA_RPM=60
# LLM_ANTHROPIC_HAIKU_RPM=30
# LLM_OLLAMA_DEVSTRAL_RPM=0   # 0 = unlimited for local

# Retry configuration
LLM_RETRY_BASE_DELAY=2.0      # Base delay for exponential backoff (seconds)
LLM_RETRY_MAX_DELAY=60.0      # Maximum delay between retries (seconds)

# Adaptive throttling (reduces RPM when hitting rate limits)
LLM_THROTTLE_ENABLED=true     # Enable adaptive throttling
LLM_THROTTLE_MIN_FACTOR=0.25  # Minimum throttle factor (25% of configured RPM)
LLM_THROTTLE_RECOVERY_TIME=60 # Seconds before trying to increase RPM

# Circuit breaker (stops requests when provider is failing)
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=5  # Consecutive failures to open circuit
LLM_CIRCUIT_RECOVERY_TIME=30     # Seconds before testing recovery

# ==============================================================================
# OLDER SINGLE-PROVIDER SETTINGS
# ==============================================================================
# Before model configs, one provider was chosen with LLM_PROVIDER (azure, openai, anthropic,
# ollama, mistral, lmstudio) and LLM_<PROVIDER>_API_KEY, _MODEL and _API_URL. They are still read
# when LLM_DEFAULT_MODEL is unset and LLM_PROVIDER is set, but a model config below is the way to go.

# ==============================================================================
# BENCHMARK MODEL CONFIGURATIONS
# ==============================================================================
# Naming: LLM_{NAME}_* -> CLI name is lowercase with hyphens (AZURE_GPT4MINI -> azure-gpt4mini)
#
# Required fields per model:
#   LLM_{NAME}_PROVIDER  - Provider type: azure, openai, anthropic, ollama, lmstudio, mistral
#   LLM_{NAME}_MODEL     - Model name/identifier
#   LLM_{NAME}_URL       - API endpoint URL
#   LLM_{NAME}_KEY       - API key (optional for local providers)
#   LLM_{NAME}_KEY_ENV   - Env var name containing API key (alternative to _KEY)
#
# Optional fields:
#   LLM_{NAME}_SAMPLING  - false for models that take no temperature; Deriva then leaves the
#                          temperature out. Unset, it follows the model: Anthropic models that
#                          refuse a temperature (Claude Haiku 5.5) get none
#   LLM_{NAME}_REASONING - Reasoning level: none (off), low, medium, high (openai, azure, anthropic)
#   LLM_{NAME}_TEMPERATURE - This model's own temperature (0 to 2), over LLM_TEMPERATURE
#   LLM_{NAME}_CONTEXT   - The model's context size in tokens (a local server's window, such as
#                          Ollama's 4096-token default); a call that fills it is warned
# ==============================================================================

# --- CLOUD PROVIDERS ---

# Mistral Small 4 (cloud) -> use as: mistral-small
# Answers without reasoning by default; $0.15 / $0.60 per million tokens (October 2026)
LLM_MISTRAL_SMALL_PROVIDER=mistral
LLM_MISTRAL_SMALL_MODEL=mistral-small-2603
LLM_MISTRAL_SMALL_KEY=your-mistral-api-key

# OpenAI GPT-6 Luna (cloud) -> use as: openai-luna
# Reasoning off, so the step temperatures apply; $0.10 / $0.50 per million tokens (October 2026)
LLM_OPENAI_LUNA_PROVIDER=openai
LLM_OPENAI_LUNA_MODEL=gpt-6-luna
LLM_OPENAI_LUNA_KEY=your-openai-api-key
LLM_OPENAI_LUNA_REASONING=none

# Azure OpenAI deployment (cloud) -> use as: azure-deployment
# The model is the deployment's name in your Azure resource
LLM_AZURE_DEPLOYMENT_PROVIDER=azure
LLM_AZURE_DEPLOYMENT_MODEL=your-deployment
LLM_AZURE_DEPLOYMENT_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-08-01-preview
LLM_AZURE_DEPLOYMENT_KEY=your-azure-api-key

# --- LOCAL PROVIDERS (Ollama) ---

# Ollama devstral-small (local) -> use as: ollama-devstral
# Mistral's code-focused model
LLM_OLLAMA_DEVSTRAL_PROVIDER=ollama
LLM_OLLAMA_DEVSTRAL_MODEL=devstral-small-2
LLM_OLLAMA_DEVSTRAL_URL=http://localhost:11434/api/chat
# Ollama serves a 4096-token window unless started with OLLAMA_CONTEXT_LENGTH; name the window here
LLM_OLLAMA_DEVSTRAL_CONTEXT=4096

# Ollama Nemotron (local) -> use as: ollama-nemotron
# NVIDIA's reasoning model
LLM_OLLAMA_NEMOTRON_PROVIDER=ollama
LLM_OLLAMA_NEMOTRON_MODEL=nemotron-3-nano:30b
LLM_OLLAMA_NEMOTRON_URL=http://localhost:11434/api/chat

# --- LOCAL PROVIDERS (LM Studio) ---

# LM Studio local model -> use as: lmstudio-local
# Uses whatever model is loaded in LM Studio
LLM_LMSTUDIO_LOCAL_PROVIDER=lmstudio
LLM_LMSTUDIO_LOCAL_MODEL=local-model
LLM_LMSTUDIO_LOCAL_URL=http://localhost:1234/v1/chat/completions

# --- ANTHROPIC (Direct API) ---

# Anthropic Claude models via direct API
# Model Pricing (per Million Tokens, October 2026):
#   haiku 5.5: $0.10/$0.50 (prompts up to 100K tokens)
#   sonnet 5.5: $2/$10

# Anthropic Claude Haiku 5.5 -> use as: anthropic-haiku
# Takes no temperature (SAMPLING=false); thinking off
LLM_ANTHROPIC_HAIKU_PROVIDER=anthropic
LLM_ANTHROPIC_HAIKU_MODEL=claude-haiku-5-5
LLM_ANTHROPIC_HAIKU_KEY=your-anthropic-api-key
LLM_ANTHROPIC_HAIKU_SAMPLING=false
LLM_ANTHROPIC_HAIKU_REASONING=none

# Anthropic Claude Sonnet 5.5 -> use as: anthropic-sonnet
LLM_ANTHROPIC_SONNET_PROVIDER=anthropic
LLM_ANTHROPIC_SONNET_MODEL=claude-sonnet-5-5
LLM_ANTHROPIC_SONNET_KEY=your-anthropic-api-key

# ==============================================================================
# TOKEN LIMITS FOR CHUNKING
# ==============================================================================
# Used for automatic file chunking during extraction
# All limits are raw token counts (80% safety margin applied automatically)
# Default: 32000 tokens for benchmark consistency across models

# Default token limit for unknown models
LLM_TOKEN_LIMIT_DEFAULT=32000

# Per-model token limits (optional - overrides defaults)
# Format: LLM_TOKEN_LIMIT_{MODEL_NAME}=tokens
# Model names should match benchmark model names (uppercase, underscores)
LLM_TOKEN_LIMIT_MISTRAL_SMALL=32000
LLM_TOKEN_LIMIT_OPENAI_LUNA=32000
LLM_TOKEN_LIMIT_ANTHROPIC_HAIKU=32000

# ==============================================================================
# REPOSITORY MANAGER CONFIGURATION
# ==============================================================================
# Workspace directory for cloned repositories and runtime data
REPOSITORY_WORKSPACE_DIR=workspace/repositories

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================
# Default output directory for exported ArchiMate XML files
OUTPUT_DIR=workspace/output/model.xml

# ==============================================================================
# DATABASE CONFIGURATION (DuckDB)
# ==============================================================================
# Note: Database path is hardcoded at deriva/adapters/database/sql.db
# DATABASE_PATH env var is not currently used by the database adapter
